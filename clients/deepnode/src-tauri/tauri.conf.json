{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepNode",
  "version": "0.1.0",
  "identifier": "com.deeppool.deepnode",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    },
    "devUrl": "http://localhost:5174",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepNode",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "visible": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/localserver"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
