{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "DeepNode 默认权限：允许启动 localserver sidecar 进程、访问本地 HTTP 服务",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "localserver",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost" },
        { "url": "http://localhost:*" },
        { "url": "http://101.33.255.185:*" },
        { "url": "http://*.deeppool.com" },
        { "url": "https://*.deeppool.com" }
      ]
    }
  ]
}
